# Public build-time config (ARCH-14). Copy to `.env` for local builds.
# Everything here ships inside the app bundle: never put secrets here.
# The USDA API key is user runtime data entered in the app (ARCH-10), never an env var.

# Food provider base URLs (PROV-01)
EXPO_PUBLIC_USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
EXPO_PUBLIC_OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org
EXPO_PUBLIC_OFF_PRODUCT_BASE_URL=https://world.openfoodfacts.org

# Open Food Facts User-Agent contact (PROV-01, ROAD-04)
EXPO_PUBLIC_OFF_CONTACT_EMAIL=ricardo_reis@live.com

# Dev builds only: 1 inserts sample diary entries around today, once (ROAD-01 M2). Ignored in release builds.
EXPO_PUBLIC_DEV_SEED_DIARY=0

# Dev builds only: 1 inserts deterministic local custom + cached OFF foods for the M5 Android offline Maestro flow.
# Ignored in release builds (ARCH-18).
EXPO_PUBLIC_DEV_SEED_FOOD_SEARCH=0
